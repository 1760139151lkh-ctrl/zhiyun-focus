# Public source allowlist. Add new source types deliberately.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/启用清晰人声.cmd
!/停止清晰人声.cmd
!/LICENSES/
!/docs/
!/viewer/

/LICENSES/*
!/LICENSES/Apache-2.0.txt
!/LICENSES/WebView2.LICENSE.txt
!/LICENSES/WebView2.NOTICE.txt
/docs/*
!/docs/PROJECT_MAP.md

/viewer/*
!/viewer/build.py
!/viewer/serve.py
!/viewer/package.json
!/viewer/STORAGE.md
!/viewer/src/
!/viewer/chat/
!/viewer/companion/
!/viewer/audio-helper/
/viewer/src/*
!/viewer/src/*.js
!/viewer/src/start.html
/viewer/chat/*
!/viewer/chat/*.js
/viewer/companion/*
!/viewer/companion/*.cs
!/viewer/companion/build.ps1
!/viewer/companion/stop.ps1
!/viewer/companion/fetch_sdk.py
!/viewer/companion/webview2.lock.json
!/viewer/companion/README.md
/viewer/audio-helper/*
!/viewer/audio-helper/*.py
!/viewer/audio-helper/requirements.txt
!/viewer/audio-helper/assets.lock.json
!/viewer/audio-helper/README.md

# Runtime data, credentials and generated artifacts stay local.
**/__pycache__/
**/*.pyc
**/*.log
**/*.pid
**/.env
**/.env.*
**/node_modules/
**/.venv/
**/cv-env/
**/webview2-sdk/
**/*.exe
**/*.dll
**/*.pdb
**/*.build.json
**/.zjf-build-*/
**/.zjf-sdk-*/
